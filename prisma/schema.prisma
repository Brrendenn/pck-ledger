// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// prisma/schema.prisma

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum SheetType {
  EXPENSE_ONLY
  DEBIT_CREDIT
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String    @unique
  password  String?
  role      Role      @default(EDITOR)
  image     String?
  accounts  Account[]
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id             String          @id @default(cuid())
  name           String
  company        String          @default("PT PERDANA CIPTA KREASINDO")
  location       String?
  contactName    String?         // Default PIC (e.g. "Bpk Ardi")
  contactPhone   String?         // Default Phone (e.g. "0857-1431-7510")
  sheets         Sheet[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Vendor {
  id          String   @id @default(cuid())
  name        String   @unique
  address     String?
  signerName  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Sheet {
  id           String        @id @default(cuid())
  name         String
  category     String?
  type         SheetType     @default(DEBIT_CREDIT)
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([projectId, name])
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime
  code        String
  description String
  category    String?
  debit       Decimal  @default(0) @db.Decimal(15, 2)
  credit      Decimal  @default(0) @db.Decimal(15, 2)

  sheetId String
  sheet   Sheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sheetId, date])
}

model PurchaseOrder {
  id       String   @id @default(cuid())
  poNumber String   @unique
  date     DateTime

  companyName    String  @default("PT PERDANA CIPTA KREASINDO")
  companyAddress String? @default("The Icon Ritzone N7 No 36")
  companyCity    String? @default("Tangerang Selatan")
  companyPhone   String? @default("+6281295006061")
  companyEmail   String? @default("ptperdanaciptakreasindo@gmail.com")

  vendorName       String
  vendorSignerName String?

  shipToAddress String
  shipToContact String?
  shipToPhone   String?

  notes          String? @db.Text
  authorizerName String  @default("RICHARD EDWIN GIOVANI")

  subtotal    Float  @default(0)
  totalAmount Float  @default(0)
  status      String @default("ISSUED") // "DRAFT" | "ISSUED" | "COMPLETED" | "CANCELLED"

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  items       PurchaseOrderItem[]
  adjustments PurchaseOrderAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([poNumber])
}

model PurchaseOrderItem {
  id            String        @id @default(cuid())
  poId          String
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  itemIndex   Int    @default(1)
  description String @db.Text
  quantity    Float  @default(0)
  unitPrice   Float  @default(0)
  totalPrice  Float  @default(0)

  createdAt DateTime @default(now())

  @@index([poId])
}

model PurchaseOrderAdjustment {
  id            String        @id @default(cuid())
  poId          String
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  adjustmentIndex Int    @default(1) // 1 to 4 for the blank lines below Subtotal
  label           String // e.g., "PPN 11%", "PPH 23", "Diskon", "Ongkir"
  amount          Float  @default(0) // Positive or negative adjustment amount

  createdAt DateTime @default(now())

  @@index([poId])
}
