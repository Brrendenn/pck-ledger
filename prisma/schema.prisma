// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SheetType {
  EXPENSE_ONLY
  DEBIT_CREDIT
}

model Project {
  id        String   @id @default(cuid())
  name      String   // e.g., "Project Pabrik Kongkie"
  company   String   // e.g., "PT. PCK"
  sheets    Sheet[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sheet {
  id           String        @id @default(cuid())
  name         String        // e.g., "Kas", "Pembukuan Global"
  type         SheetType     @default(DEBIT_CREDIT)
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime // "Tanggal"
  code        String   // "Kode" (e.g., MT, UM, UP)
  description String   // "Keterangan"
  debit       Decimal  @default(0) @db.Decimal(15, 2) // "Debet" (Money In)
  credit      Decimal  @default(0) @db.Decimal(15, 2) // "Credit" (Money Out)
  
  sheetId     String
  sheet       Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // This index is critical for fast chronological sorting when calculating the running balance
  @@index([sheetId, date]) 
}