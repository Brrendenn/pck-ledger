// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SheetType {
  EXPENSE_ONLY
  DEBIT_CREDIT
}

model Project {
  id        String   @id @default(cuid())
  name      String   // e.g., "PROJECT PABRIK KONGKIE"
  company   String   // e.g., "PT. PCK"
  sheets    Sheet[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sheet {
  id           String        @id @default(cuid())
  name         String        // e.g., "Kas", "Pembukuan Gardu Listrik"
  category     String?       // e.g., "Gardu", "Cool Storage", "Mess"
  type         SheetType     @default(DEBIT_CREDIT)
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([projectId, name])
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime
  code        String   // "MT", "UM", "UP", etc.
  description String
  category    String?  // Category tag (e.g., "Gardu")
  debit       Decimal  @default(0) @db.Decimal(15, 2)
  credit      Decimal  @default(0) @db.Decimal(15, 2)
  
  sheetId     String
  sheet       Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sheetId, date])
}